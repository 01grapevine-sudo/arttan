{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/page.js": {
      "includeFiles": "{app.html,core.js,data.js,artists/*/artist.js}"
    },
    "api/crawl-cron.js": {
      "maxDuration": 300
    },
    "api/crawl.js": {
      "maxDuration": 60
    },
    "api/push-send.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "arttan.co.kr"
        }
      ],
      "destination": "https://www.arttan.co.kr/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "arttan.vercel.app"
        }
      ],
      "destination": "https://www.arttan.co.kr/:path*",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page?t=home"
    },
    {
      "source": "/artist/:id",
      "destination": "/api/page?t=artist&id=:id"
    },
    {
      "source": "/artist/:id/work/:n",
      "destination": "/api/page?t=work&id=:id&n=:n"
    },
    {
      "source": "/gallery/:id",
      "destination": "/api/page?t=gallery&id=:id"
    },
    {
      "source": "/exhibition/:id",
      "destination": "/api/page?t=exhibition&id=:id"
    },
    {
      "source": "/book/:id",
      "destination": "/api/page?t=book&id=:id"
    },
    {
      "source": "/review/:id",
      "destination": "/api/page?t=review&id=:id"
    },
    {
      "source": "/interview/:id",
      "destination": "/api/page?t=interview&id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/page?t=sitemap"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/page?t=rss"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/artists/(.*)\\.(jpg|jpeg|png|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/artists/(.*)\\.(mp4|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/artists/eloi/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noimageindex"
        }
      ]
    },
    {
      "source": "/galleries/testgal(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noimageindex"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/crawl-cron",
      "schedule": "0 21 * * *"
    }
  ]
}
